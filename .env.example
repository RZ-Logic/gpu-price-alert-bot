# Copy to .env and fill in. .env is git-ignored.
DISCORD_BOT_TOKEN=
# Optional: your server id, so slash commands appear instantly in that server (and only there)
DISCORD_GUILD_ID=
# Optional, for global commands (DISCORD_GUILD_ID empty): comma-separated server ids where the
# commands answer. With both empty, they answer only in servers the bot's owner is in.
ALLOWED_GUILD_IDS=
# Minutes between background price checks
CHECK_INTERVAL_MINUTES=60
# Comma-separated retailer ids to skip: bestbuy, canadacomputers, memoryexpress, newegg, amazon, walmart
DISABLED_RETAILERS=
# Where the SQLite database lives
GPU_ALERTS_DATA_DIR=data
# Any valid Canadian postal code (Best Buy stock lookups)
BESTBUY_POSTAL_CODE=M5G2C3
